# Copy to .env and edit. Generate a key with:  python3 -c "import secrets; print(secrets.token_hex(32))"
FOCUS_SECRET_KEY=change-me-to-a-long-random-hex

# Corporate DNS resolvers for the container (host networking still uses the
# container's own resolv.conf; without these, internal names like an SMTP
# relay won't resolve).
FOCUS_DNS1=10.0.0.53
FOCUS_DNS2=10.0.0.54

# Production behind a reverse proxy / edge:
# FOCUS_ROOT_PATH=/focus       # the subpath served (from the browser URL)
# FOCUS_PORT=9094              # host port (host networking)
# FOCUS_COOKIE_SECURE=1        # HTTPS via the edge

# Optional overrides
# FOCUS_COOKIE_NAME=focus_session
# FOCUS_INVITE_TTL_DAYS=7
# FOCUS_ADMIN_USERNAME=admin       # seeded default admin (fresh DB only)
# FOCUS_ADMIN_PASSWORD=admin       # must be changed on first login
# FOCUS_MANAGER_USERNAME=manager   # seeded default manager (fills in even if DB has other users)
# FOCUS_MANAGER_PASSWORD=manager   # must be changed on first login
# FOCUS_STALE_WEEKS=2          # weeks with no update before an open item is flagged "stale"

# HOLO single sign-on hand-off (same host, separate app on port 9093). Empty
# SSO_SHARED_SECRET = the "HOLO" nav button is hidden. Must be set to the
# EXACT SAME value in HOLO's own .env — this is a shared secret between the
# two apps, NOT either app's own FOCUS_SECRET_KEY/HOLO_SECRET_KEY.
# SSO_SHARED_SECRET=change-me-to-a-long-random-value-matching-holo
# HOLO_BASE_URL=http://localhost:9093
